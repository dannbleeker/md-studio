{
  "name": "md-studio",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "Dann Bleeker Pedersen",
  "description": "Local-first Markdown editor PWA with synced visual and raw panes.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:bundle-size": "node ./scripts/check-bundle-size.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm knip && pnpm test && pnpm build && pnpm test:e2e && pnpm check:bundle-size",
    "book": "pnpm book:epub && pnpm book:pdf && pnpm book:guide",
    "book:epub": "node ./scripts/build-book-epub.mjs",
    "book:pdf": "node ./scripts/build-book-pdf.mjs",
    "book:guide": "node ./scripts/build-guide-pdf.mjs",
    "mutation": "stryker run stryker.mutation.config.mjs && node ./scripts/mutation-score.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/kit": "^7.22.2",
    "codemirror": "^6.0.2",
    "docx": "^9.8.1",
    "entities": "^7.0.1",
    "marked": "^18.0.14",
    "pdf-lib": "^1.17.1",
    "prosemirror-search": "^1.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "jszip": "^3.10.2",
    "knip": "^6.39.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome"
    ],
    "overrides": {
      "qs": "^6.16.0"
    }
  }
}
